<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/card"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/humanName"
            style="@style/Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/humanReason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/status_calling"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:textColor="@color/amber"
            android:textSize="12sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/humanRefAmount"
        style="@style/Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp" />
    <TextView
        android:id="@+id/humanQuote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/quote_panel"
        android:lineSpacingExtra="3dp"
        android:padding="12dp"
        android:textColor="@color/ink"
        android:textSize="14sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/humanCall"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="2"
            android:background="@drawable/primary_button"
            android:text="☎  ফোন করুন"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp" />
        <Button
            android:id="@+id/humanDecision"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:background="@drawable/outline_button"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
